# Public form submission endpoints, NOT API keys. Set before building.
# Leave empty until the form and notification email have been verified.
NEXT_PUBLIC_FORMSPREE_GENERAL_ENDPOINT=
# Optional separate form; defaults to the general endpoint when empty.
NEXT_PUBLIC_FORMSPREE_HEFAMAA_ENDPOINT=

# Keep static until the hosting account's runtime and startup are confirmed.
# Use npm run build:node for a Node.js-compatible production build.
HURKIFY_DEPLOY_TARGET=static

# Healthcare community (public URL and public anon/publishable key only).
# Never put a service-role key in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
